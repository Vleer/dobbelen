# syntax=docker/dockerfile:1.7
# Production backend build (used by docker-compose.prod.yml).

FROM gradle:8.10-jdk21 AS builder
WORKDIR /app

COPY build.gradle settings.gradle ./

RUN --mount=type=cache,target=/home/gradle/.gradle \
    gradle dependencies --no-daemon -x test || true

COPY src src

RUN --mount=type=cache,target=/home/gradle/.gradle \
    gradle build -x test --no-daemon

FROM eclipse-temurin:21-jre

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app
COPY --from=builder /app/build/libs/backend-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -f -s http://localhost:8080/actuator/health || exit 1

ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
